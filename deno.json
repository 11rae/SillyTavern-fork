{
    "permissions": {
        "default": {
            "read": {
                "allow": [
                    ".",
                    "/.dockerenv",
                    "/usr/bin/ldd",
                    "/proc/self/cgroup"
                ]
            },
            "write": {
                "allow": ["."]
            },
            "run": {
                "allow": [
                    "open",
                    "cmd",
                    "xdg-open",
                    "firefox",
                    "google-chrome",
                    "microsoft-edge",
                    "brave-browser"
                ]
            },
            "env": {
                "allow": true
            },
            "net": {
                "allow": true
            },
            "ffi": {
                "allow": true
            },
            "sys": {
                "allow": true
            }
        }
    },
    "exclude": [
        "**/node_modules/**",
        "**/dist/**",
        "**/.git/**",
        "public/lib/**",
        "backups/**",
        "data/**",
        "cache/**",
        "src/tokenizers/**",
        "docker/**",
        "plugins/**",
        "**/*.min.js",
        "public/scripts/extensions/quick-reply/lib/**",
        "public/scripts/extensions/tts/lib/**"
    ],
    "fmt": {
        "useTabs": false,
        "indentWidth": 4,
        "semiColons": true,
        "singleQuote": true,
        "trailingCommas": "always"
    },
    "lint": {
        "rules": {
            "tags": ["recommended"],
            "exclude": [
                "no-control-regex",
                "require-yield",
                "no-async-promise-executor",
                "no-inner-declarations"
            ]
        }
    },
    "nodeModulesDir": "auto"
}
