{
    "permissions": {
        "default": {
            "read": {
                "allow": [
                    ".",
                    "/.dockerenv",
                    "/usr/bin/ldd",
                    "/proc/self/cgroup",
                    "/proc/version"
                ]
            },
            "write": {
                "allow": ["."],
                "deny": [
                    "deno.json",
                    "package.json",
                    "deno.lock",
                    "package-lock.json",
                    "start.sh",
                    "Start.bat",
                    "UpdateAndStart.bat",
                    "UpdateForkAndStart.bat"
                ]
            },
            "run": {
                "allow": [
                    "cmd",
                    "cmd.exe",
                    "xdg-open",
                    "firefox",
                    "google-chrome",
                    "microsoft-edge",
                    "brave-browser"
                ]
            },
            "env": {
                "allow": true
            },
            "net": {
                "allow": true
            },
            "ffi": {
                "allow": true
            },
            "sys": {
                "allow": true
            }
        }
    },
    "nodeModulesDir": "auto"
}
